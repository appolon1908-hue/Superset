# Non-secret Superset runtime identity and mounted-file paths.
CODESTRA_SUPERSET_IMAGE=ghcr.io/appolon1908-hue/superset-superset@sha256:REPLACE_WITH_64_LOWERCASE_HEX
CODESTRA_SOURCE_SHA=REPLACE_WITH_40_LOWERCASE_HEX
CODESTRA_IMAGE_DIGEST=sha256:REPLACE_WITH_64_LOWERCASE_HEX
CODESTRA_ENVIRONMENT=staging
CODESTRA_REGION=hetzner-eu
CODESTRA_SERVER=central-observability
CODESTRA_SUPERSET_DEPLOYMENT_ID=REPLACE_WITH_IMMUTABLE_RELEASE_ID

SUPERSET_SECRET_KEY_FILE_SOURCE=/run/secrets/codestra/superset/secret-key
SUPERSET_METADATA_DATABASE_URI_FILE_SOURCE=/run/secrets/codestra/superset/metadata-database-uri
SUPERSET_REDIS_URL_FILE_SOURCE=/run/secrets/codestra/superset/redis-url
SUPERSET_OIDC_CLIENT_SECRET_FILE_SOURCE=/run/secrets/codestra/superset/oidc-client-secret
