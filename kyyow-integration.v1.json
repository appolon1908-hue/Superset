{
  "schema": "kyyow.platform-component.v1",
  "repository": "appolon1908-hue/Superset",
  "component": "superset",
  "authority": "business-intelligence",
  "exposure": "authenticated-ui",
  "native_ports": [
    8088
  ],
  "inputs": [
    "analytics-read-models:read-only"
  ],
  "outputs": [],
  "controls": [
    "certified read models, replicas, or warehouse schemas only",
    "database-native tenant RLS and Superset RLS are both required",
    "no OLTP, provider, crawler, Middleware, or Odoo write credentials",
    "Keycloak login and export auditing are required"
  ],
  "identity": {
    "authority": "appolon1908-hue/Keycloak",
    "workload_identity_required": true,
    "anonymous_admin_access": false
  },
  "secrets": {
    "authority": "appolon1908-hue/Codestra-OpenBao",
    "secrets_in_git": false,
    "environment_plaintext_secrets": false
  },
  "operations": {
    "middleware_is_sole_odoo_writer": true,
    "grafana_read_only": true,
    "superset_read_only": true
  },
  "activation": {
    "source_contract_complete": true,
    "runtime_evidence_complete": false,
    "production_activation_authorized": false
  }
}
